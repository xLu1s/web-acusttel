---
import { href } from "../lib/url";
import { addressLines, email, phoneDisplay, phoneTel } from "../data/site";
---

<aside class="side-card">
  <p class="eyebrow">Contacto</p>
  <a class="tel" href={`tel:${phoneTel}`}>{phoneDisplay}</a>
  <p><a href={`mailto:${email}`}>{email}</a></p>
  <p>
    {addressLines.map((line) => (
      <>
        {line}<br />
      </>
    ))}
  </p>
  <p class="actions">
    <a class="btn btn-primary dark" href={href("/solicitud-presupuesto/")}>Pedir presupuesto</a>
    <a class="btn btn-line" href={`tel:${phoneTel}`}>Habla con un técnico</a>
  </p>
</aside>
