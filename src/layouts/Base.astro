---
import "@fontsource-variable/outfit/wght.css";
import "@fontsource-variable/source-sans-3/wght.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { abs, asset, href } from "../lib/url";
import { email, phoneTel, socials } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  overlay?: boolean;
  crumbs?: { label: string; href: string }[];
}
const { title, description, image = "media/hero-poster.webp", overlay = false, crumbs = [] } = Astro.props;
const fullTitle = title === "Acusttel" ? "Acusttel · Consultoría acústica y telecomunicaciones" : `${title} · Acusttel`;
const path = Astro.url.pathname;
const canonical = abs(path.replace(import.meta.env.BASE_URL, "/") || "/");
const ogImage = abs(image.startsWith("http") ? "/" : `/${image.replace(/^\//, "")}`);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Acusttel",
  legalName: "Acústica y Telecomunicaciones S.L.",
  taxID: "B-96677315",
  url: abs("/"),
  logo: abs("/brand/acusttel.gif"),
  image: abs("/media/hero-poster.webp"),
  email,
  telephone: phoneTel,
  foundingDate: "1997",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Pol. Ind. Benieto, C/ Del Transporte, nº 12, Bloque 2, Nave 14",
    postalCode: "46702",
    addressLocality: "Gandia",
    addressRegion: "Valencia",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 38.9589671,
    longitude: -0.1776678,
  },
  areaServed: ["ES", "CL", "PL", "RO", "TR", "MX", "SA"],
  sameAs: socials.map((s) => s.href),
  description: "Consultoría acústica y de telecomunicaciones. Laboratorio de ensayos, instalaciones y desarrollo de productos.",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#142033" />
    <link rel="icon" href={asset("favicon.png")} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Acusttel" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {overlay && <link rel="preload" as="image" href={asset("media/hero-poster.webp")} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header overlay={overlay} current={path.replace(import.meta.env.BASE_URL, "/") || "/"} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/ui.ts";
    </script>
  </body>
</html>
